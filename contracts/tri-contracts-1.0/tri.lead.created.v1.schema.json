{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tri-contracts/1.0/tri.lead.created.v1",
  "title": "TRI Lead Created v1",
  "type": "object",
  "required": [
    "contract_version",
    "event_type",
    "event_id",
    "source_system",
    "occurred_at",
    "lead",
    "attribution"
  ],
  "properties": {
    "contract_version": {
      "const": "tri-contracts/1.0"
    },
    "event_type": {
      "const": "tri.lead.created.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "source_system": {
      "const": "blog-plano-saude"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "lead": {
      "type": "object",
      "required": [
        "external_id",
        "name",
        "phone",
        "consent_lgpd"
      ],
      "properties": {
        "external_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 254
        },
        "city": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z]{2}$"
        },
        "lives": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000
        },
        "interest_profile": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "plan_type": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "consent_lgpd": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "properties": {
        "origin": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 120
        },
        "page": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "referrer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "utm_source": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 250
        },
        "utm_medium": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 250
        },
        "utm_campaign": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 250
        },
        "utm_content": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 250
        },
        "utm_term": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 250
        },
        "fbclid": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "gclid": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
